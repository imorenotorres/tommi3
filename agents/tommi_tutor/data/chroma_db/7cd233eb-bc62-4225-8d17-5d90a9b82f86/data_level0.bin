sqlite3 data/database.db < tu_esquema.sql

# O crear tablas manualmente
sqlite3 data/database.db << 'EOF'
CREATE TABLE clientes (
    id INTEGER PRIMARY KEY,
    nombre TEXT NOT NULL,
    email TEXT,
    ciudad TEXT
);

INSERT INTO clientes VALUES (1, 'Ana GarcÃ­a', 'ana@email.com', 'Madrid');
INSERT INTO clientes VALUES (2, 'Carlos LÃ³pez', 'carlos@email.com', 'Barcelona');
EOF
