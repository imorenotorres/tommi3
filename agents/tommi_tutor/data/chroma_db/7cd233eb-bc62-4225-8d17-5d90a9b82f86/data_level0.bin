curl -X POST http://localhost:8000/chat \\
  -H "Content-Type: application/json" \\
  -d '{{"message": "Â¿CuÃ¡ntos registros hay en la tabla clientes?"}}'

# Ver el esquema de la BD
curl http://localhost:8000/schema
